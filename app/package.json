{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,api -c blue,green \"npm:dev:next\" \"npm:dev:api\"",
    "dev:next": "next dev",
    "dev:api": ".venv/bin/python -m uvicorn index:app --app-dir api --reload --reload-dir api --port ${API_PORT:-8000}",
    "start:api": ".venv/bin/python -m uvicorn index:app --app-dir api --port ${API_PORT:-8000}",
    "setup:api": "python3 -m venv .venv && .venv/bin/pip install -r api/requirements.txt",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
